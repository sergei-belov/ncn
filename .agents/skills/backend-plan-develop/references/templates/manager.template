    @staticmethod
    async def delete_multiple_{{plural_resource_name}}(
        project_id: UUID,
        {{resource_name}}_ids: list[UUID],
    ) -> api_models.Delete{{ClassName}}sResponse:
        async with Services.database.session() as session:
            deleted_{{resource_name}}s = await Database.{{plural_resource_name}}.delete_many(ids={{resource_name}}_ids, project_id=project_id)

        deleted_ids = {item.id for item in deleted_{{resource_name}}s}
